<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_SellerOnboarding" targetNamespace="https://souqly.io/bpmn"
                  exporter="Souqly" exporterVersion="1">

  <bpmn:process id="seller-onboarding" name="Seller onboarding" isExecutable="true"
                camunda:historyTimeToLive="P180D">
    <bpmn:documentation>KYC review of a seller application. Every status change runs in its own
      asynchronous job together with the event that announces it.</bpmn:documentation>

    <bpmn:startEvent id="Start_Submitted" name="Application submitted">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Screen" name="Screen application" camunda:asyncBefore="true"
                      camunda:expression="${onboarding.screen(execution)}">
      <bpmn:documentation>Looks for other applicants with the same bank account or trade licence.</bpmn:documentation>
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:incoming>Flow_Resubmitted</bpmn:incoming>
      <bpmn:outgoing>Flow_Screened</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_AssessRisk" name="Assess risk" camunda:decisionRef="kyc-risk"
                           camunda:resultVariable="riskTier" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements>
        <camunda:executionListener event="end" expression="${onboarding.recordRisk(execution)}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Screened</bpmn:incoming>
      <bpmn:outgoing>Flow_Assessed</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:userTask id="Task_Review" name="Review application" camunda:candidateGroups="compliance"
                   camunda:dueDate="${reviewDueAt}">
      <bpmn:incoming>Flow_Assessed</bpmn:incoming>
      <bpmn:outgoing>Flow_Reviewed</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Timer_ReviewSla" name="Review SLA missed" attachedToRef="Task_Review"
                        cancelActivity="false">
      <bpmn:outgoing>Flow_SlaMissed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_ReviewSla">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${reviewSla}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_Escalate" name="Escalate to compliance leads"
                      camunda:expression="${onboarding.escalate(execution)}">
      <bpmn:incoming>Flow_SlaMissed</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalated</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Escalated" name="Escalated">
      <bpmn:incoming>Flow_Escalated</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision?">
      <bpmn:incoming>Flow_Reviewed</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_MoreInformation</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_HighRisk" name="High risk?">
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_HighRisk</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotHighRisk</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_SecondReview" name="Second review (four eyes)"
                   camunda:candidateGroups="compliance-leads">
      <bpmn:documentation>Must be decided by someone other than the first reviewer.</bpmn:documentation>
      <bpmn:incoming>Flow_HighRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_SecondReviewed</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_SecondDecision" name="Second decision?">
      <bpmn:incoming>Flow_SecondReviewed</bpmn:incoming>
      <bpmn:outgoing>Flow_SecondApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_SecondReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Provision" name="Grant seller role in Keycloak" camunda:asyncBefore="true"
                      camunda:expression="${onboarding.provision(execution)}">
      <bpmn:incoming>Flow_NotHighRisk</bpmn:incoming>
      <bpmn:incoming>Flow_SecondApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_Provisioned</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Approve" name="Record approval" camunda:asyncBefore="true"
                      camunda:expression="${onboarding.approve(execution)}">
      <bpmn:incoming>Flow_Provisioned</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Approved" name="Seller approved">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Reject" name="Record rejection" camunda:asyncBefore="true"
                      camunda:expression="${onboarding.reject(execution)}">
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_SecondReject</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Rejected" name="Application rejected">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_RequestInformation" name="Request information" camunda:asyncBefore="true"
                      camunda:expression="${onboarding.requestInformation(execution)}">
      <bpmn:incoming>Flow_MoreInformation</bpmn:incoming>
      <bpmn:outgoing>Flow_InformationRequested</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_ProvideInformation" name="Provide more information" camunda:assignee="${applicantId}">
      <bpmn:documentation>Completed when the applicant resubmits their application.</bpmn:documentation>
      <bpmn:incoming>Flow_InformationRequested</bpmn:incoming>
      <bpmn:outgoing>Flow_Resubmitted</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Timer_InformationDeadline" name="No answer in time"
                        attachedToRef="Task_ProvideInformation">
      <bpmn:outgoing>Flow_DeadlinePassed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_InformationDeadline">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${informationDeadline}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_Expire" name="Expire application" camunda:asyncBefore="true"
                      camunda:expression="${onboarding.expire(execution)}">
      <bpmn:incoming>Flow_DeadlinePassed</bpmn:incoming>
      <bpmn:outgoing>Flow_Expired</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Expired" name="Application expired">
      <bpmn:incoming>Flow_Expired</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Submitted" targetRef="Task_Screen" />
    <bpmn:sequenceFlow id="Flow_Screened" sourceRef="Task_Screen" targetRef="Task_AssessRisk" />
    <bpmn:sequenceFlow id="Flow_Assessed" sourceRef="Task_AssessRisk" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Reviewed" sourceRef="Task_Review" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_SlaMissed" sourceRef="Timer_ReviewSla" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_Escalated" sourceRef="Task_Escalate" targetRef="End_Escalated" />
    <bpmn:sequenceFlow id="Flow_Approve" name="Approve" sourceRef="Gateway_Decision" targetRef="Gateway_HighRisk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'APPROVE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject" name="Reject" sourceRef="Gateway_Decision" targetRef="Task_Reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'REJECT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MoreInformation" name="More information" sourceRef="Gateway_Decision"
                       targetRef="Task_RequestInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'MORE_INFO'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HighRisk" name="Yes" sourceRef="Gateway_HighRisk" targetRef="Task_SecondReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riskTier == 'HIGH'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotHighRisk" name="No" sourceRef="Gateway_HighRisk" targetRef="Task_Provision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riskTier != 'HIGH'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SecondReviewed" sourceRef="Task_SecondReview" targetRef="Gateway_SecondDecision" />
    <bpmn:sequenceFlow id="Flow_SecondApprove" name="Approve" sourceRef="Gateway_SecondDecision"
                       targetRef="Task_Provision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${secondDecision == 'APPROVE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SecondReject" name="Reject" sourceRef="Gateway_SecondDecision"
                       targetRef="Task_Reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${secondDecision == 'REJECT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Provisioned" sourceRef="Task_Provision" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Task_Approve" targetRef="End_Approved" />
    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Task_Reject" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_InformationRequested" sourceRef="Task_RequestInformation"
                       targetRef="Task_ProvideInformation" />
    <bpmn:sequenceFlow id="Flow_Resubmitted" name="Resubmitted" sourceRef="Task_ProvideInformation"
                       targetRef="Task_Screen" />
    <bpmn:sequenceFlow id="Flow_DeadlinePassed" sourceRef="Timer_InformationDeadline" targetRef="Task_Expire" />
    <bpmn:sequenceFlow id="Flow_Expired" sourceRef="Task_Expire" targetRef="End_Expired" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_SellerOnboarding">
    <bpmndi:BPMNPlane id="Plane_SellerOnboarding" bpmnElement="seller-onboarding">
      <bpmndi:BPMNShape id="Start_Submitted_di" bpmnElement="Start_Submitted"><dc:Bounds x="172" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Screen_di" bpmnElement="Task_Screen"><dc:Bounds x="260" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssessRisk_di" bpmnElement="Task_AssessRisk"><dc:Bounds x="420" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review"><dc:Bounds x="580" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_ReviewSla_di" bpmnElement="Timer_ReviewSla"><dc:Bounds x="612" y="262" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Escalate_di" bpmnElement="Task_Escalate"><dc:Bounds x="580" y="340" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Escalated_di" bpmnElement="End_Escalated"><dc:Bounds x="712" y="362" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true"><dc:Bounds x="745" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HighRisk_di" bpmnElement="Gateway_HighRisk" isMarkerVisible="true"><dc:Bounds x="865" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SecondReview_di" bpmnElement="Task_SecondReview"><dc:Bounds x="960" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SecondDecision_di" bpmnElement="Gateway_SecondDecision" isMarkerVisible="true"><dc:Bounds x="1115" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Provision_di" bpmnElement="Task_Provision"><dc:Bounds x="1220" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approve_di" bpmnElement="Task_Approve"><dc:Bounds x="1370" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Approved_di" bpmnElement="End_Approved"><dc:Bounds x="1522" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject_di" bpmnElement="Task_Reject"><dc:Bounds x="1220" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected"><dc:Bounds x="1372" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestInformation_di" bpmnElement="Task_RequestInformation"><dc:Bounds x="720" y="480" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProvideInformation_di" bpmnElement="Task_ProvideInformation"><dc:Bounds x="880" y="480" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_InformationDeadline_di" bpmnElement="Timer_InformationDeadline"><dc:Bounds x="912" y="542" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Expire_di" bpmnElement="Task_Expire"><dc:Bounds x="880" y="620" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Expired_di" bpmnElement="End_Expired"><dc:Bounds x="1042" y="642" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_di" bpmnElement="Flow_Start"><di:waypoint x="208" y="240" /><di:waypoint x="260" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Screened_di" bpmnElement="Flow_Screened"><di:waypoint x="360" y="240" /><di:waypoint x="420" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Assessed_di" bpmnElement="Flow_Assessed"><di:waypoint x="520" y="240" /><di:waypoint x="580" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reviewed_di" bpmnElement="Flow_Reviewed"><di:waypoint x="680" y="240" /><di:waypoint x="745" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SlaMissed_di" bpmnElement="Flow_SlaMissed"><di:waypoint x="630" y="298" /><di:waypoint x="630" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Escalated_di" bpmnElement="Flow_Escalated"><di:waypoint x="680" y="380" /><di:waypoint x="712" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approve_di" bpmnElement="Flow_Approve"><di:waypoint x="795" y="240" /><di:waypoint x="865" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reject_di" bpmnElement="Flow_Reject"><di:waypoint x="770" y="215" /><di:waypoint x="770" y="40" /><di:waypoint x="1270" y="40" /><di:waypoint x="1270" y="60" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MoreInformation_di" bpmnElement="Flow_MoreInformation"><di:waypoint x="770" y="265" /><di:waypoint x="770" y="480" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HighRisk_di" bpmnElement="Flow_HighRisk"><di:waypoint x="915" y="240" /><di:waypoint x="960" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotHighRisk_di" bpmnElement="Flow_NotHighRisk"><di:waypoint x="890" y="265" /><di:waypoint x="890" y="310" /><di:waypoint x="1270" y="310" /><di:waypoint x="1270" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SecondReviewed_di" bpmnElement="Flow_SecondReviewed"><di:waypoint x="1060" y="240" /><di:waypoint x="1115" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SecondApprove_di" bpmnElement="Flow_SecondApprove"><di:waypoint x="1165" y="240" /><di:waypoint x="1220" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SecondReject_di" bpmnElement="Flow_SecondReject"><di:waypoint x="1140" y="215" /><di:waypoint x="1140" y="100" /><di:waypoint x="1220" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Provisioned_di" bpmnElement="Flow_Provisioned"><di:waypoint x="1320" y="240" /><di:waypoint x="1370" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved"><di:waypoint x="1470" y="240" /><di:waypoint x="1522" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected"><di:waypoint x="1320" y="100" /><di:waypoint x="1372" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InformationRequested_di" bpmnElement="Flow_InformationRequested"><di:waypoint x="820" y="520" /><di:waypoint x="880" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Resubmitted_di" bpmnElement="Flow_Resubmitted"><di:waypoint x="980" y="520" /><di:waypoint x="1020" y="520" /><di:waypoint x="1020" y="440" /><di:waypoint x="310" y="440" /><di:waypoint x="310" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DeadlinePassed_di" bpmnElement="Flow_DeadlinePassed"><di:waypoint x="930" y="578" /><di:waypoint x="930" y="620" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Expired_di" bpmnElement="Flow_Expired"><di:waypoint x="980" y="660" /><di:waypoint x="1042" y="660" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
