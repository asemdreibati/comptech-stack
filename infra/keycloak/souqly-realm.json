{
  "realm": "souqly",
  "displayName": "Souqly",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "roles": {
    "realm": [
      {
        "name": "buyer",
        "description": "Shops on the storefront: checks out and reads their own orders.",
        "composite": true,
        "composites": {
          "client": {
            "order-service": [
              "order:place"
            ]
          }
        }
      },
      {
        "name": "seller",
        "description": "Manages stock for the seller account in the seller_id claim.",
        "composite": true,
        "composites": {
          "client": {
            "inventory-service": [
              "stock:read",
              "stock:write"
            ],
            "catalog-service": [
              "product:write"
            ]
          }
        }
      },
      {
        "name": "admin",
        "description": "Marketplace operations staff.",
        "composite": true,
        "composites": {
          "client": {
            "inventory-service": [
              "stock:read",
              "stock:write",
              "stock:write-any",
              "flash-sale:manage",
              "reservation:write"
            ],
            "catalog-service": [
              "category:manage",
              "product:write",
              "product:write-any"
            ],
            "order-service": [
              "order:read-any"
            ]
          }
        }
      }
    ],
    "client": {
      "inventory-service": [
        {
          "name": "stock:read",
          "description": "Read stock levels"
        },
        {
          "name": "stock:write",
          "description": "Restock SKUs (sellers: only their own)"
        },
        {
          "name": "stock:write-any",
          "description": "Restock any SKU regardless of owning seller"
        },
        {
          "name": "flash-sale:manage",
          "description": "Arm and disarm flash-sale gates"
        },
        {
          "name": "reservation:write",
          "description": "Create, confirm and release reservations"
        }
      ],
      "catalog-service": [
        {
          "name": "category:manage",
          "description": "Create categories and link them to Form.io forms"
        },
        {
          "name": "product:write",
          "description": "Create and edit listings (sellers: only their own)"
        },
        {
          "name": "product:write-any",
          "description": "Edit any listing regardless of owning seller"
        }
      ],
      "order-service": [
        {
          "name": "order:place",
          "description": "Check out and read one's own orders"
        },
        {
          "name": "order:read-any",
          "description": "Read any buyer's orders (support and operations)"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "inventory-service",
      "name": "Inventory service (resource server)",
      "description": "Holds the inventory permissions. No login flows are enabled.",
      "enabled": true,
      "publicClient": false,
      "secret": "inventory-service-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "catalog-service",
      "name": "Catalog service (resource server)",
      "description": "Holds the catalog permissions. No login flows are enabled.",
      "enabled": true,
      "publicClient": false,
      "secret": "catalog-service-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "order-service",
      "name": "Order service",
      "description": "Holds the order permissions (resource server) and reserves stock during checkout (client credentials).",
      "enabled": true,
      "publicClient": false,
      "secret": "order-service-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "souqly-ops",
      "name": "Operations automation",
      "description": "Back-office scripts and load tests (client credentials, admin role).",
      "enabled": true,
      "publicClient": false,
      "secret": "souqly-ops-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "seller-acme-integration",
      "name": "ACME seller ERP integration",
      "description": "A seller's own system syncing stock through the public API gateway.",
      "enabled": true,
      "publicClient": false,
      "secret": "seller-acme-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "seller_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "seller_id",
            "claim.name": "seller_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "souqly-web",
      "name": "Storefront and seller portal",
      "description": "Browser app: authorization code flow with PKCE, no secret.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "seller_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "seller_id",
            "claim.name": "seller_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "souqly-dev-cli",
      "name": "Developer CLI (local only)",
      "description": "Password grant for curl and integration tests. Never enable outside local development.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "seller_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "seller_id",
            "claim.name": "seller_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wso2-apim",
      "name": "WSO2 API Manager key manager connector",
      "description": "Lets the API gateway look up OAuth clients (read-only) when sellers map their integration to an application.",
      "enabled": true,
      "publicClient": false,
      "secret": "wso2-apim-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-order-service",
      "enabled": true,
      "serviceAccountClientId": "order-service",
      "clientRoles": {
        "inventory-service": [
          "reservation:write",
          "stock:read"
        ]
      }
    },
    {
      "username": "service-account-souqly-ops",
      "enabled": true,
      "serviceAccountClientId": "souqly-ops",
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "service-account-seller-acme-integration",
      "enabled": true,
      "serviceAccountClientId": "seller-acme-integration",
      "realmRoles": [
        "seller"
      ],
      "attributes": {
        "seller_id": [
          "acme"
        ]
      }
    },
    {
      "username": "buyer",
      "email": "buyer@souqly.dev",
      "emailVerified": true,
      "firstName": "Bea",
      "lastName": "Buyer",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "buyer-password-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "buyer"
      ]
    },
    {
      "username": "seller-acme",
      "email": "ops@acme.example",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Acme",
      "enabled": true,
      "attributes": {
        "seller_id": [
          "acme"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "seller-password-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "seller"
      ]
    },
    {
      "username": "seller-globex",
      "email": "ops@globex.example",
      "emailVerified": true,
      "firstName": "Gil",
      "lastName": "Globex",
      "enabled": true,
      "attributes": {
        "seller_id": [
          "globex"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "seller-password-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "seller"
      ]
    },
    {
      "username": "admin",
      "email": "admin@souqly.dev",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin-password-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "service-account-wso2-apim",
      "enabled": true,
      "serviceAccountClientId": "wso2-apim",
      "clientRoles": {
        "realm-management": [
          "view-clients",
          "query-clients"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"seller_id\",\"displayName\":\"Seller account\",\"validations\":{\"pattern\":{\"pattern\":\"^[a-z0-9-]{2,40}$\",\"error-message\":\"Invalid seller ID\"}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
