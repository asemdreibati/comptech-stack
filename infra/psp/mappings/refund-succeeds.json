{
  "name": "Refund of a payment intent",
  "priority": 5,
  "request": {
    "method": "POST",
    "url": "/v1/refunds",
    "headers": {"Idempotency-Key": {"matches": ".+"}}
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json"},
    "jsonBody": {
      "id": "re_{{request.headers.Idempotency-Key}}",
      "object": "refund",
      "payment_intent": "{{jsonPath request.body '$.payment_intent'}}",
      "status": "succeeded"
    },
    "transformers": ["response-template"]
  }
}
